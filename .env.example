# Burden AI — AI settings. Copy to .env.local for localhost; on Railway, add
# these under the service's Variables. Never put a real API key in this file.

# local = Ollama on this machine, anthropic = Claude
AI_PROVIDER=local
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:30b-a3b

# For Claude (later):
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional
# AI_ENABLED=true
# AI_DAILY_LIMIT=300
